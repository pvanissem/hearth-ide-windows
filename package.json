{
  "name": "hearth-ide-windows",
  "version": "0.2.0",
  "author": "Patrick van Issem <p.vanissem91@gmail.com>",
  "description": "Hearth IDE for Windows - sandboxed AI coding agents, inbox, editor and Git in one window",
  "main": "src/main/main.js",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "prestart": "powershell -NoProfile -File scripts/build-native.ps1",
    "build:native": "powershell -NoProfile -File scripts/build-native.ps1",
    "test": "node --test \"test/*.test.js\"",
    "smoke": "powershell -NoProfile -File scripts/smoke.ps1",
    "predist": "npm run build:native",
    "dist": "electron-builder --win --x64"
  },
  "build": {
    "appId": "io.github.pvanissem.hearth-windows",
    "productName": "Hearth IDE",
    "files": [
      "src/**",
      "package.json",
      "!**/node_modules/monaco-editor/{dev,esm,min-maps}/**",
      "!**/node_modules/**/*.map"
    ],
    "npmRebuild": false,
    "asarUnpack": [
      "**/node_modules/node-pty/**"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "extraResources": [
      {
        "from": "native/bin/hearth-sandbox.exe",
        "to": "native/hearth-sandbox.exe"
      }
    ],
    "nsis": {
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "shortcutName": "Hearth IDE"
    }
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "mermaid": "^12.3.0",
    "monaco-editor": "^0.57.0",
    "node-pty": "^1.1.0"
  },
  "devDependencies": {
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0"
  }
}
